# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*

# Rebuilt analysis caches and generated deliverables
outputs/
figures/
Jambi/figures/
Jambi/*.pdf
Jambi/*.pptx

# External material and local links outside this repository
ggmt-2026/
HOTSPOT

# Downloaded HYSPLIT meteorology is large; retain only small provenance records.
data/hysplit/met/*
!data/hysplit/met/.gitkeep

# Acquired GFS and source data are reproducible downloads; retain small manifests.
data/hysplit/gfs0p25/*
!data/hysplit/gfs0p25/regional/
data/hysplit/gfs0p25/regional/*
!data/hysplit/gfs0p25/**/*.json
data/bkt_sources/**
!data/bkt_sources/**/
!data/bkt_sources/**/*.json

# LaTeX and office temporary files
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
~$*

# Editor and operating-system metadata
.DS_Store
Thumbs.db
*.swp
*.swo

# Poster build resolves its node tool through a local symlink
ggmt_poster/node_modules
ggmt_poster/render-*/
ggmt_poster/lo-*/
